# Ignorar dependencias, pero asegurarse de generarlas dentro del contenedor
node_modules/
public/build/
public/hot
public/storage/
storage/*.key
storage/pail

# Laravel cache y archivos temporales
.phpunit.cache
.phpunit.result.cache
npm-debug.log
yarn-error.log

# Configuración sensible (no subir al repositorio)
.env
.env.backup
.env.production
Homestead.json
Homestead.yaml
auth.json

# Configuración de IDEs (puedes mantener si prefieres)
.fleet
.idea
.nova
.vscode
.zed

# NO ignorar vendor/ en Docker, porque Laravel necesita las dependencias
# Si quieres ignorarlo en Git pero permitirlo en Docker, usa Docker Volumes
